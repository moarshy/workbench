pyrepo-implement seed=5006 out_of_steps   reward=0.17 steps=12 peak_ctx=5387  def is_arity(n, func, sigspec=None):
    """ Does a function have only n positional arguments?

    This function relies on introspection and does not call the function.
    Returns None if validity can't be determined.

    >>> def f(x):
    ...     return x
    >>> is_arity(1, f)
    True
    >>> def g(x, y=1):
    ...     return x + y
    >>> is_arity(1, g)
    False
    """
    sigspec, rv = _check_sigspec(sigspec, func, _sigs._is_arity, n, func)
    if sigspec is None:
        return rv
    if sigspec.return_annotation is not sigspec.empty:
        pass
    if any(p.kind == p.VAR_POSITIONAL for p in sigspec.parameters.values()):
        return False
    count = 0
    for p in sigspec.parameters.values():
        if p.kind not in (p.POSITIONAL_OR_KEYWORD, p.POSITIONAL_ONLY):
            continue
        count += 1


