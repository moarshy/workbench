          "type": "string"
        },
        "exit_code": {
          "default": 0,
          "description": "Exit code of the last command",
          "title": "Exit Code",
          "type": "integer"
        },
        "steps_left": {
          "default": 0,
          "description": "Actions remaining before the task is graded automatically",
          "title": "Steps Left",
          "type": "integer"
        }
